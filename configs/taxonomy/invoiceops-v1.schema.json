{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoiceops.local/schemas/invoiceops-v1.schema.json",
  "title": "InvoiceOps v1 label taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "threshold_version", "labels"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "version": {"const": "invoiceops-v1"},
    "threshold_version": {
      "type": "string",
      "pattern": "^thresholds-v[0-9]+$"
    },
    "labels": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/label"}
    }
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "description", "risk", "examples", "thresholds"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PRICE_VARIANCE",
            "QUANTITY_RECEIPT_VARIANCE",
            "TAX_CURRENCY_AMOUNT",
            "DUPLICATE_INVOICE",
            "MISSING_PO_OR_RECEIPT",
            "PAYMENT_STATUS",
            "SUPPLIER_MASTER_CHANGE",
            "OTHER_REVIEW"
          ]
        },
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "examples": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_threshold", "auto_accept_threshold"],
          "properties": {
            "candidate_threshold": {"type": "number", "minimum": 0, "maximum": 1},
            "auto_accept_threshold": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
