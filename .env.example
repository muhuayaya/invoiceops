# Copy to .env, then set a strong random alphanumeric database password.
POSTGRES_PASSWORD=replace-with-a-random-secret
# Use this computer's actual LAN IP or DNS name for another device to reach it.
INVOICEOPS_HOST=localhost
INVOICEOPS_BIND_ADDRESS=127.0.0.1
INVOICEOPS_HTTPS_PORT=8443
# When true, hash-validated model bundles may serve without an approval.json file,
# and a default administrator is created if none exists.
INVOICEOPS_DEMO_MODE=true
INVOICEOPS_DEMO_ADMIN_EMAIL=admin@example.local
INVOICEOPS_DEMO_ADMIN_PASSWORD=InvoiceopsDemo2026
