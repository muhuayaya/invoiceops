INVOICEOPS_ENV=development
INVOICEOPS_LLM_ENABLED=false
INVOICEOPS_MAX_TEXT_LENGTH=5000
INVOICEOPS_MAX_BATCH_BYTES=10485760
INVOICEOPS_MAX_BATCH_ROWS=10000
INVOICEOPS_TAXONOMY_VERSION=invoiceops-v1
INVOICEOPS_HIGH_RISK_REVIEW_SLA_MINUTES=60
INVOICEOPS_JWT_SECRET=change-me-in-development
POSTGRES_DB=invoiceops
POSTGRES_USER=invoiceops
POSTGRES_PASSWORD=invoiceops
DATABASE_URL=postgresql+psycopg://invoiceops:invoiceops@db:5432/invoiceops
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000
VITE_API_BASE_URL=http://localhost:8000
INVOICEOPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INVOICEOPS_CELERY_ENABLED=true
INVOICEOPS_DATA_DB=/data/invoiceops.sqlite3
INVOICEOPS_BATCH_DB=/data/invoiceops-batches.sqlite3
