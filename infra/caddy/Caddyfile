{
    # 浏览器用 IP 访问时不发送 SNI，此时使用 INVOICEOPS_HOST 对应的证书
    default_sni {$INVOICEOPS_HOST}
}

# 末尾的 :443 接收任意主机名/IP 的请求，再由 INVOICEOPS_ALLOWED_HOSTS 决定哪些地址可用
{$INVOICEOPS_HOST}:443, localhost:443, :443 {
    # 优先使用 refresh_frontend_address.ps1 签发的多地址证书（certs/*.pem，同一个本地根证书签发）；
    # 目录为空时由 Caddy 本地 CA 自动签发
    tls internal {
        load /etc/caddy/certs
    }

    # 只放行当前已连接网卡的 IP（由 refresh_frontend_address.ps1 维护）和 localhost；
    # 未设置时 compose 默认放行 localhost 和任意 IPv4 地址
    @unavailable not host {$INVOICEOPS_ALLOWED_HOSTS}
    handle @unavailable {
        respond "此地址对应的网卡当前未连接，请使用 https://localhost:{$INVOICEOPS_HTTPS_PORT:8443}/ 或当前网络的 IP 访问。" 421
    }

    handle /healthz {
        reverse_proxy api:8000
    }
    handle /readyz {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:8501
    }
}
